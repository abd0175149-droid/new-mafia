# انسخ هذا الملف إلى .env وعدّل القيم
# كلمة مرور لوحة الأدمن (8 أحرف على الأقل)
ADMIN_PASSWORD=change-me-please
# سرّ توقيع جلسة الأدمن: 32 حرفاً عشوائياً على الأقل. ولّده بـ: openssl rand -hex 32
SESSION_SECRET=
# المنفذ على السيرفر (يُربط بـ 127.0.0.1 فقط، ونفق Cloudflare يوجّه إليه)
HOST_PORT=3070
# false فقط إن كنت تجرّب بدون HTTPS
COOKIE_SECURE=true
# الحد الأقصى لحجم الملف بالميغابايت
MAX_FILE_MB=15
